# =============================================================================
# apps/web — Environment variables (Agrilogy farmer web app, Next.js 16)
# =============================================================================
# Copy to `.env.local` for local dev, or set these in the Vercel project
# (Root Directory = apps/web). Only NEXT_PUBLIC_* vars are exposed to the
# browser. Do NOT commit real secrets.
#
# All variables below are ACTUALLY referenced in code — see the file noted
# in each comment.

# -----------------------------------------------------------------------------
# Core: backend API + admin console (the key ones for Vercel setup)
# -----------------------------------------------------------------------------

# Base URL of the agri-api backend. Used as the axios baseURL for every API
# call. Falls back to https://back.agrogo-datafarm.com if unset.
# Used in: packages/api-client/src/api.ts
NEXT_PUBLIC_API_URL=https://back.agrogo-datafarm.com

# URL of the SEPARATE admin console (agri-admin repo). The login page
# redirects staff users here ("staff login"). Falls back to /admin locally.
# Used in: apps/web/src/app/login/LoginBox.tsx
NEXT_PUBLIC_ADMIN_URL=https://back.agrogo-datafarm.com

# Where the 401 interceptor and the logout buttons send the user. Under SSO
# this should be a FULL URL to the identity gateway login so logout/expiry
# lands on the gateway (a relative /login is used only in standalone local dev).
# Defaults to /login if unset.
# Used in: packages/api-client/src/api.ts + the logout handlers
# Prod (SSO):  https://identity.agrogo-datafarm.com/login
# Local dev:   /login
NEXT_PUBLIC_LOGIN_PATH=/login

# -----------------------------------------------------------------------------
# Single sign-on (shared cross-subdomain cookie dropped by the identity gateway)
# -----------------------------------------------------------------------------

# Domain the SSO cookie is scoped to, so logout can expire it for every sibling
# *.agrogo-datafarm.com app. In prod set the shared PARENT domain (leading dot);
# leave EMPTY in local dev (host-only cookie).
# Used in: packages/api-client/src/clearSsoSession.ts
# Prod:       .agrogo-datafarm.com
# Local dev:  (empty)
NEXT_PUBLIC_SSO_COOKIE_DOMAIN=

# Name of the shared SSO cookie. Must match what the identity gateway sets.
# Defaults to agrogo_sso if unset.
# Used in: packages/api-client/src/hydrateSsoSession.ts + clearSsoSession.ts
NEXT_PUBLIC_SSO_COOKIE_NAME=agrogo_sso

# -----------------------------------------------------------------------------
# Map
# -----------------------------------------------------------------------------

# Mapbox GL access token for the agriculture map. Without it the map will not
# render. Get one from https://account.mapbox.com/ (public token, pk.*).
# Used in: apps/web/src/app/components/map/AgricultureMapboxMap.tsx
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=pk.xxxx

# -----------------------------------------------------------------------------
# Chatbot
# -----------------------------------------------------------------------------

# Anthropic API key for the in-app assistant. SERVER-SIDE ONLY (no NEXT_PUBLIC_
# prefix) — it is never shipped to the browser. The chatbot calls /api/chat, which
# proxies to Anthropic with this key.
# Used in: apps/web/src/app/api/chat/route.ts
ANTHROPIC_API_KEY=sk-ant-xxxx

# -----------------------------------------------------------------------------
# Local dev only — same-origin API proxy (no-op in production)
# -----------------------------------------------------------------------------

# When set, Next rewrites /api-proxy/:path* -> $PROXY_API_TARGET/:path* so the
# browser stays same-origin during local dev (the prod backend only CORS-allows
# the www origin). Leave UNSET in Vercel/production.
# Used in: apps/web/next.config.mjs
# PROXY_API_TARGET=https://back.agrogo-datafarm.com
